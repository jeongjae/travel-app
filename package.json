{
  "name": "travel-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "node scripts/run-app.mjs dev",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "ai:server": "node --env-file-if-exists=.env.local server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run typecheck && vite build",
    "preview": "node scripts/run-app.mjs preview",
    "preview:ui": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "node scripts/playwright.mjs test",
    "browser:install": "node scripts/playwright.mjs install chromium",
    "format": "prettier --write --ignore-unknown src server scripts tests \"*.{ts,mjs,json,yaml}\" index.html .github",
    "format:check": "prettier --check --ignore-unknown src server scripts tests \"*.{ts,mjs,json,yaml}\" index.html .github",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test && pnpm run build",
    "test:pilot-env": "node scripts/check-pilot-environment.mjs",
    "check:pilot-bundle": "node scripts/check-pilot-bundle.mjs",
    "check:pilot-node": "node scripts/check-pilot-node.mjs",
    "check:pilot": "pnpm run check:pilot-node && pnpm run test:pilot-env && pnpm run check:pilot-bundle"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@zip.js/zip.js": "2.24.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
